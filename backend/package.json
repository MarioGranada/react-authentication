{
  "name": "react-authentication-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the react-authentication events demo (JWT auth, Postgres on Supabase).",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env.local server.js",
    "dev": "node --env-file-if-exists=../.env.local --watch server.js",
    "db:migrate": "node --env-file-if-exists=../.env.local scripts/db.js migrate",
    "db:reset": "node --env-file-if-exists=../.env.local scripts/db.js reset"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.9"
  }
}
